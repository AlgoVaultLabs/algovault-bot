#!/usr/bin/env bash
# OPS-BOT-CI-LINT-TYPECHECK-CLEANUP-W1 — client-side lint/type push gate.
#
# `algovault-bot` has NO GHA deploy (deploy is manual ssh+rsync+systemctl), so
# a red `ruff`/`mypy` CI run gates nothing server-side and lint/type debt can
# silently re-accumulate. This hook is the deploy-gate the repo otherwise
# lacks: it runs ruff+mypy before every push and blocks on red.
#
# Reuses the project's AOE client-side pre-push pattern (CLAUDE.md ## Git rules).
# Activate per clone:  git config --local core.hooksPath hooks
#
# git invokes pre-push with (remote, url) args + ref lines on stdin; a lint
# gate ignores them and just runs the checks — non-zero exit aborts the push.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# OPS-BOT-CHATID-REDACT-W1 — capture git's ref lines BEFORE any block runs.
# git writes `<local ref> <local sha> <remote ref> <remote sha>` to this hook's stdin ONCE, and
# every block below inherits that stdin — so the first child that happens to read it would
# silently swallow what the chat-id gate needs, and that gate would scan an EMPTY push range and
# report PASS. Read it here, before anything else can. A TTY means a human ran this file by hand:
# there is no push, so there are no refs (and `cat` would otherwise hang).
if [ -t 0 ]; then PUSH_REFS=""; else PUSH_REFS="$(cat)"; fi

echo "[pre-push] running lint + type checks (ruff + mypy)…"
bash "$ROOT/scripts/lint.sh"

# GROWTH-TG-QUOTA-PARITY-W1 CH3d — the quota-refusal seam gate.
#
# `scripts/lint.sh` runs ruff + mypy only, so until this wave the seam gate (and now its L5
# hand-typed-allowance leg) was caught by CI alone — i.e. AFTER the push that broke it.
#
# 🛑 GATES ON THE TOKEN, NEVER THE EXIT CODE. `verification-gates.md`: a guard with a fail-open
# branch prints exactly one terminal `<GATE>_VERDICT=` line and callers read THAT. Reading `$?`
# here would let a broken interpreter (exit != 0, no verdict) read as a policy failure, and a
# fail-open exit 0 read as a pass.
#
# INDETERMINATE does not block: it means the gate could not evaluate, which is not evidence that
# the tree is bad, and blocking every push on our own tooling breakage is the fleet-wedge this
# repo has already paid for. It is LOUD instead.
echo "[pre-push] running quota-refusal seam gate…"
SEAM_PY="${ALGOVAULT_PY:-python3}"
[ -x "$ROOT/.venv/bin/python" ] && SEAM_PY="$ROOT/.venv/bin/python"
# 🛑 `|| true` IS LOAD-BEARING, AND WITHOUT IT EVERY LINE OF COMMENT ABOVE WAS FALSE.
# Line 14 is `set -euo pipefail`. Under `set -e` a failing command substitution in a plain
# assignment aborts the shell AT THIS LINE, so the token-reading `case` below was DEAD CODE for
# every non-zero gate exit. Measured against a stubbed gate: FAIL exited 1 printing NOTHING (the
# diagnostic and "push refused" never ran), and INDETERMINATE exited 3 and BLOCKED THE PUSH —
# the exact opposite of the promise three comments up. The defect predates this wave and was
# invisible because no leg had ever emitted a non-PASS verdict; V2 CH1 R4 ships the first ones
# that can. `|| true` hands the exit code back to the `case`, which is what "gates on the TOKEN,
# never the exit code" actually requires.
SEAM_OUT="$("$SEAM_PY" "$ROOT/scripts/check-quota-refusal-seam.py" 2>&1 || true)"
SEAM_VERDICT="$(printf '%s\n' "$SEAM_OUT" | grep -oE '^QUOTA_REFUSAL_SEAM_VERDICT=[A-Z]+' | tail -1)"
case "$SEAM_VERDICT" in
  QUOTA_REFUSAL_SEAM_VERDICT=PASS)
    echo "[pre-push] $SEAM_VERDICT" ;;
  QUOTA_REFUSAL_SEAM_VERDICT=FAIL)
    printf '%s\n' "$SEAM_OUT"
    echo "[pre-push] $SEAM_VERDICT — push refused." >&2
    exit 1 ;;
  *)
    printf '%s\n' "$SEAM_OUT" >&2
    echo "[pre-push] seam gate emitted no verdict (INDETERMINATE) — NOT blocking, but it verified nothing." >&2 ;;
esac

# OPS-BOT-DEAD-SURFACE-SWEEP-W1 CH3 R8 — the orphan-module gate.
#
# `paywall.py` was unreachable for ~80 days and nothing went red, because nothing was asking.
# This block asks, on every push. Note `hooks/` is NOT in ops/deploy/algovault-bot.manifest by
# design, so this is a developer-checkout gate (plus CI) and never runs on the host.
#
# 🛑 SAME CONTRACT AS THE SEAM GATE ABOVE, FOR THE SAME REASONS. Gates on the TOKEN, never `$?`.
# `|| true` is LOAD-BEARING: line 14 is `set -euo pipefail`, under which a failing command
# substitution in a plain assignment aborts the shell right here — which is measured to have made
# the seam gate's own token-reading `case` dead code for every non-zero exit. Do not remove it.
#
# INDETERMINATE does not block: it means the gate could not evaluate (an unparseable file, a
# declared entrypoint that has vanished), which is not evidence the tree is bad. It is LOUD.
echo "[pre-push] running orphan-module gate…"
ORPHAN_PY="${ALGOVAULT_PY:-python3}"
[ -x "$ROOT/.venv/bin/python" ] && ORPHAN_PY="$ROOT/.venv/bin/python"
ORPHAN_OUT="$("$ORPHAN_PY" "$ROOT/scripts/check-orphan-modules.py" 2>&1 || true)"
ORPHAN_VERDICT="$(printf '%s\n' "$ORPHAN_OUT" | grep -oE '^ORPHAN_MODULES_VERDICT=[A-Z]+' | tail -1)"
case "$ORPHAN_VERDICT" in
  ORPHAN_MODULES_VERDICT=PASS)
    echo "[pre-push] $ORPHAN_VERDICT" ;;
  ORPHAN_MODULES_VERDICT=FAIL)
    printf '%s\n' "$ORPHAN_OUT"
    echo "[pre-push] $ORPHAN_VERDICT — push refused." >&2
    exit 1 ;;
  *)
    printf '%s\n' "$ORPHAN_OUT" >&2
    echo "[pre-push] orphan gate emitted no verdict (INDETERMINATE) — NOT blocking, but it verified nothing." >&2 ;;
esac

# OPS-BOT-CHATID-REDACT-W1 — the chat-id literal gate, over exactly what this push PUBLISHES.
#
# This repo is PUBLIC, and real subscriber chat ids reached it as incident evidence: in comments,
# test values, test names, docs and commit MESSAGES. CI's tree scan (`tests/test_chat_id_literals.py`)
# runs only AFTER a push and never reads a message. This block hands the captured ref lines to
# `--push-range`, which scans every commit being pushed — added lines AND messages. It is the one
# place a leak can still be STOPPED rather than cleaned up by rewriting public history.
#
# 🛑 SAME CONTRACT AS THE BLOCKS ABOVE: gates on the TOKEN, never `$?`, and INDETERMINATE does not
# block but is LOUD. `|| true` is LOAD-BEARING on BOTH captures, not just the first: under
# `set -euo pipefail` a gate that prints NO token makes `grep` exit 1, which fails the verdict
# pipeline and aborts the shell at that assignment — silently, exit 1, before the `case` runs.
# Measured: `X="$(printf 'no token\n' | grep -oE '^V=[A-Z]+' | tail -1)"` exits 1 and prints nothing.
echo "[pre-push] running chat-id literal gate…"
IDLIT_PY="${ALGOVAULT_PY:-python3}"
[ -x "$ROOT/.venv/bin/python" ] && IDLIT_PY="$ROOT/.venv/bin/python"
IDLIT_OUT="$(printf '%s\n' "$PUSH_REFS" | "$IDLIT_PY" "$ROOT/scripts/check-chat-id-literals.py" --push-range 2>&1 || true)"
IDLIT_VERDICT="$(printf '%s\n' "$IDLIT_OUT" | grep -oE '^CHAT_ID_LITERALS_VERDICT=[A-Z]+' | tail -1 || true)"
case "$IDLIT_VERDICT" in
  CHAT_ID_LITERALS_VERDICT=PASS)
    echo "[pre-push] $IDLIT_VERDICT" ;;
  CHAT_ID_LITERALS_VERDICT=FAIL)
    printf '%s\n' "$IDLIT_OUT"
    echo "[pre-push] $IDLIT_VERDICT — push refused." >&2
    exit 1 ;;
  *)
    printf '%s\n' "$IDLIT_OUT" >&2
    echo "[pre-push] chat-id literal gate emitted no verdict (INDETERMINATE) — NOT blocking, but it verified nothing." >&2 ;;
esac

echo "✓ pre-push checks passed"
